# Copy this file to .env and fill in real values. Never commit the real .env.

# ==============================================================================
# 1. CORE & LOCAL DEPLOYMENT (Required for local development)
# ==============================================================================
PORT=8000
MAX_FILE_SIZE_MB=25
MAX_UPLOAD_MB=25
UPLOAD_DIR=./data/raw
LOG_LEVEL=INFO

# Frontend connection to Backend Gateway
# Local development default: http://127.0.0.1:8000
# Docker compose default: http://backend:8000
# Cloud deployment: https://your-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000

# CORS settings (comma-separated origins or * for permissive access)
ALLOWED_ORIGINS=*

# Self-RAG bounded retry limit (default: 2 retries)
SELF_RAG_MAX_RETRIES=2

# Hugging Face model cache offline switch (prevents slow network probes)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1


# ==============================================================================
# 2. PDF PARSER & OCR SETTINGS (pdf_parser_module)
# ==============================================================================
# Minimum character count on a page before trusting extracted text over OCR fallback
OCR_TEXT_THRESHOLD=20

# Rendering DPI for OCR rasterization (higher improves accuracy, lower is faster)
OCR_DPI=200

# Path to Tesseract OCR binary (leave empty if in system PATH; e.g. /usr/bin/tesseract)
TESSERACT_CMD=


# ==============================================================================
# 3. VECTOR DATABASE (Qdrant)
# ==============================================================================
# Mode A: Local Qdrant (Docker or native)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Mode B: Qdrant Cloud Managed Cluster (Overrides local host/port when provided)
# Free tier cluster available at https://cloud.qdrant.io
# QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key


# ==============================================================================
# 4. LLM PROVIDERS & VISION (Optional - System falls back to offline modes)
# ==============================================================================
# Google Gemini API Key: Powers Gemini 2.5 Flash generation, query rewriting, and Gemini Vision
# If set, Gemini is preferred over OpenAI.
GEMINI_API_KEY=

# OpenAI API Key: Powers GPT-4o-mini generation, query rewriting, and GPT-4o Vision
# If unset, OmniBrain operates in offline mode (local embeddings + heuristic synthesis + Pillow inspection)
OPENAI_API_KEY=sk-placeholder-openai-key


# ==============================================================================
# 5. OBSERVABILITY & TRACING (Langfuse)
# ==============================================================================
# Optional: Set valid keys to send real spans to Langfuse Cloud
# In-memory mock tracer active when placeholder keys are detected
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder-public-key
LANGFUSE_SECRET_KEY=sk-lf-placeholder-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

